{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Yarp": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "aicos",
    "Audience": "aicos-clients",
    "SigningKey": "",
    "ExpiryMinutes": 60
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "http://localhost:3000"
    ]
  },
  "RateLimiting": {
    "PermitLimitPerMinute": 600
  },
  "ReverseProxy": {
    "Routes": {
      "identity-route":  { "ClusterId": "identity",  "Match": { "Path": "/api/v1/identity/{**catch-all}" } },
      "menu-route":      { "ClusterId": "menu",      "Match": { "Path": "/api/v1/menu/{**catch-all}" } },
      "tables-route":    { "ClusterId": "table",     "Match": { "Path": "/api/v1/tables/{**catch-all}" } },
      "orders-route":    { "ClusterId": "order",     "Match": { "Path": "/api/v1/orders/{**catch-all}" } },
      "payments-route":  { "ClusterId": "payment",   "Match": { "Path": "/api/v1/payments/{**catch-all}" } },
      "kitchen-route":   { "ClusterId": "kitchen",   "Match": { "Path": "/api/v1/kitchen/{**catch-all}" } },
      "workforce-route": { "ClusterId": "workforce", "Match": { "Path": "/api/v1/workforce/{**catch-all}" } },
      "reporting-route": { "ClusterId": "reporting", "Match": { "Path": "/api/v1/reporting/{**catch-all}" } },
      "customers-route": { "ClusterId": "customer",  "Match": { "Path": "/api/v1/customers/{**catch-all}" } },
      "ai-route":        { "ClusterId": "ai",        "Match": { "Path": "/api/v1/ai/{**catch-all}" } }
    },
    "Clusters": {
      "identity":  { "Destinations": { "primary": { "Address": "http://localhost:5101" } } },
      "menu":      { "Destinations": { "primary": { "Address": "http://localhost:5102" } } },
      "table":     { "Destinations": { "primary": { "Address": "http://localhost:5103" } } },
      "order":     { "Destinations": { "primary": { "Address": "http://localhost:5104" } } },
      "payment":   { "Destinations": { "primary": { "Address": "http://localhost:5105" } } },
      "kitchen":   { "Destinations": { "primary": { "Address": "http://localhost:5107" } } },
      "workforce": { "Destinations": { "primary": { "Address": "http://localhost:5108" } } },
      "reporting": { "Destinations": { "primary": { "Address": "http://localhost:5109" } } },
      "customer":  { "Destinations": { "primary": { "Address": "http://localhost:5110" } } },
      "ai":        { "Destinations": { "primary": { "Address": "http://localhost:5111" } } }
    }
  }
}
