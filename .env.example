# Copy to .env to override the defaults used by docker-compose.yml. All values below are DEV-ONLY.

POSTGRES_DB=aicos
POSTGRES_USER=aicos_admin
POSTGRES_PASSWORD=aicos_admin_dev

# Password shared by all per-service PostgreSQL roles (identity_svc, ordering_svc, ...).
# NOTE: only applied when the postgres volume is created. To change it later: docker compose down -v
SERVICE_DB_PASSWORD=aicos_dev

# HMAC key used to sign/validate JWTs in every service. Must be >= 32 characters.
JWT_SIGNING_KEY=dev-only-signing-key-change-me-0123456789abcdef

# AI providers (leave empty until the AI service needs them)
GROQ_API_KEY=
DEEPSEEK_API_KEY=
