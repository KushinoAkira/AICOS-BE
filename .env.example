# Copy to .env (or run scripts/init-env.ps1 / scripts/init-env.sh, which fills in random values).
# docker-compose.yml refuses to start while a required value below is missing: nothing secret has a default.
# .env is git-ignored. Never commit real values.

POSTGRES_DB=aicos
POSTGRES_USER=aicos_admin
# Superuser of the database container.
POSTGRES_PASSWORD=
# Password shared by the per-service PostgreSQL roles (identity_svc, ordering_svc, ...). Applied when the postgres volume is first created;
# to change it afterwards run `docker compose down -v` (this erases the data).
SERVICE_DB_PASSWORD=
REDIS_PASSWORD=

# HMAC key that signs the JWTs of every service, at least 32 characters.
JWT_SIGNING_KEY=
# 32 random bytes, base64. Encrypts payment provider credentials. Losing it makes the stored credentials unreadable.
PAYMENTS_SECRET_KEY=

# First platform Super Admin, created by the Identity service when none exists.
SEED_ADMIN_EMAIL=admin@aicos.local
SEED_ADMIN_PASSWORD=

# Only for `docker compose --profile tools up -d`
PGADMIN_EMAIL=admin@aicos.local
PGADMIN_PASSWORD=

# Production by default. For a demo you may set: ASPNETCORE_ENVIRONMENT=Development, SWAGGER_ENABLED=true, PAYMENTS_ALLOW_SIMULATION=true
ASPNETCORE_ENVIRONMENT=Production
SWAGGER_ENABLED=false
PAYMENTS_ALLOW_SIMULATION=false

# Web origins the gateway accepts (CORS). Defaults: Vite dev 8443 and 5173, FE Docker image 8088. Add the deployed site here, for example
# https://aicos-3028a.web.app. Origin = scheme + host + port, no path and no trailing slash.
CORS_ORIGIN_1=http://localhost:8443
CORS_ORIGIN_2=http://localhost:8088
CORS_ORIGIN_3=http://localhost:5173
CORS_ORIGIN_4=http://127.0.0.1:8088

# AI providers (leave empty until the AI service needs them)
GROQ_API_KEY=
DEEPSEEK_API_KEY=

# Mail server for the emails of the Identity service (password reset code, brand registration received/approved/refused).
# Leave SMTP_HOST empty and the mails are only written to the service log (nothing is sent). To send real mail fill in at least
# SMTP_HOST and SMTP_FROM_ADDRESS; the rest depends on your provider (Gmail, Brevo, Mailgun, SendGrid SMTP, your own server...).
# SMTP_SECURITY: StartTls (port 587, usual), Ssl (port 465) or None (local test server only).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=StartTls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
SMTP_FROM_NAME=AICOS
# Address of the web app, used for the sign-in link in the approval mail, for example https://app.yourbrand.vn (empty: no link).
APP_URL=
