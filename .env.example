# Copy to .env to override the defaults used by docker-compose.yml. All values below are DEV-ONLY.

POSTGRES_DB=aicos_db
PAYMENT_MUTATIONS_ENABLED=false
POSTGRES_USER=aicos_admin
POSTGRES_PASSWORD=replace-with-a-local-admin-password

# Use a different generated password for each runtime role. These placeholders
# are not real credentials. Values are only consumed when a fresh PostgreSQL
# instance creates its roles; rotate existing roles with an approved DBA step.
IDENTITY_DB_PASSWORD=replace-with-identity-password
MENU_DB_PASSWORD=replace-with-menu-password
TABLE_DB_PASSWORD=replace-with-table-password
ORDERING_DB_PASSWORD=replace-with-ordering-password
PAYMENT_DB_PASSWORD=replace-with-payment-password
INVENTORY_DB_PASSWORD=replace-with-inventory-password
KITCHEN_DB_PASSWORD=replace-with-kitchen-password
WORKFORCE_DB_PASSWORD=replace-with-workforce-password
REPORTING_DB_PASSWORD=replace-with-reporting-password
CUSTOMER_DB_PASSWORD=replace-with-customer-password
# URI-encode reserved URL characters in this value because AI uses DATABASE_URL.
AI_DB_PASSWORD=replace-with-ai-password

# HMAC key used to sign/validate JWTs in every service. Must be >= 32 characters.
JWT_SIGNING_KEY=replace-with-at-least-32-random-characters

# AI providers (leave empty until the AI service needs them)
GROQ_API_KEY=
DEEPSEEK_API_KEY=
