# Copy to .env (or run scripts/init-env.ps1 / scripts/init-env.sh, which fills in random values).
# docker-compose.yml refuses to start while a required value below is missing: nothing secret has a default.
# .env is git-ignored. Never commit real values.

POSTGRES_DB=aicos
POSTGRES_USER=aicos_admin
# Superuser of the database container.
POSTGRES_PASSWORD=
# Password shared by the per-service PostgreSQL roles (identity_svc, ordering_svc, ...). Applied when the postgres volume is first created;
# to change it afterwards run `docker compose down -v` (this erases the data).
SERVICE_DB_PASSWORD=
REDIS_PASSWORD=

# HMAC key that signs the JWTs of every service, at least 32 characters.
JWT_SIGNING_KEY=
# 32 random bytes, base64. Encrypts payment provider credentials. Losing it makes the stored credentials unreadable.
PAYMENTS_SECRET_KEY=

# First platform Super Admin, created by the Identity service when none exists.
SEED_ADMIN_EMAIL=admin@aicos.local
SEED_ADMIN_PASSWORD=

# Only for `docker compose --profile tools up -d`
PGADMIN_EMAIL=admin@aicos.local
PGADMIN_PASSWORD=

# Production by default. For a demo you may set: ASPNETCORE_ENVIRONMENT=Development, SWAGGER_ENABLED=true, PAYMENTS_ALLOW_SIMULATION=true
ASPNETCORE_ENVIRONMENT=Production
SWAGGER_ENABLED=false
PAYMENTS_ALLOW_SIMULATION=false

# AI providers (leave empty until the AI service needs them)
GROQ_API_KEY=
DEEPSEEK_API_KEY=
